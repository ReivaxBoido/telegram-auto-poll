# telegram-auto-poll configuration.
# Copy to .env and replace every placeholder. Never commit .env.
# See CONSTITUTION.md §8 for validation rules and full semantics.

# --- Required -----------------------------------------------------------------

# BotFather token. Secret: never log, commit, or share.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN

# Comma-separated numeric Telegram user IDs allowed to administer the bot via DM.
# At least one. Use two or more when two operators exist, to avoid lockout.
ADMIN_USER_IDS=100000001,100000002

# --- Storage ------------------------------------------------------------------

# Absolute SQLite path inside the container. The /data volume must be writable.
DATABASE_URL=sqlite+aiosqlite:////data/telegram-auto-poll.db
DATA_DIR=/data

# --- Behaviour ----------------------------------------------------------------

DEFAULT_TIMEZONE=UTC
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Local default is loopback. In Compose set HEALTH_HOST=0.0.0.0 so the
# published port can reach it, and publish only 127.0.0.1:8080 on the host.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
METRICS_ENABLED=true

# --- Sign-up poll rendering and voting ----------------------------------------

# Names shown per option in the message; the renderer reduces this to fit 4,096 chars.
RESPONSE_NAMES_PER_OPTION=10
# Coalesce rapid vote toggles into one edit per message. 0 edits immediately.
RESPONSE_UPDATE_DEBOUNCE_SECONDS=1.0
# Per-user vote budget.
VOTES_PER_MINUTE=30
# Retain responses for closed/deleted instances this long, then redact and delete.
RESPONSE_RETENTION_DAYS=90
# Bounded message-edit concurrency and retries.
MESSAGE_EDIT_CONCURRENCY=4
MESSAGE_EDIT_RETRY_ATTEMPTS=3
# How often the posting worker wakes to claim pending messages.
POSTING_TICK_SECONDS=5

# --- Posting retries and limits -----------------------------------------------

SEND_RETRY_ATTEMPTS=3
SEND_RETRY_BASE_SECONDS=2
SEND_CONCURRENCY=4
BOT_POLL_TIMEOUT_SECONDS=30
CLOCK_SKEW_WARNING_SECONDS=60

# --- Scheduling (reserved for SPEC-004) ---------------------------------------

SCHEDULER_TICK_SECONDS=15
SEND_GRACE_SECONDS=120

# --- Admin UX and safety ------------------------------------------------------

ADMIN_COMMANDS_PER_MINUTE=20
WIZARD_TTL_SECONDS=900

# --- Retention and database ---------------------------------------------------

RETENTION_DAYS=90
DB_BUSY_TIMEOUT_MS=5000
SHUTDOWN_GRACE_SECONDS=30
MIGRATE_ON_STARTUP=true

# One-time migration guard. Set true only for the 0002 destructive reset after a
# verified backup; remove it afterwards. The migration aborts if old rows exist.
ALLOW_DESTRUCTIVE_MIGRATION=false

# --- Build metadata (normally injected by CI/Docker; placeholders for local) ---

BUILD_VERSION=dev
BUILD_SHA=unknown
